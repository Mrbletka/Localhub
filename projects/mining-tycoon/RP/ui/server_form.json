{
  "namespace": "server_form",
  "main_screen_content": {
    "size": [
      "100%",
      "100%"
    ],
    "modifications": [
      {
        "array_name": "controls",
        "operation": "insert_back",
        "value": [
          {
            "mining_tycoon_form_factory": {
              "type": "panel",
              "size": [
                "100%",
                "100%"
              ],
              "factory": {
                "name": "server_form_factory",
                "control_ids": {
                  "long_form": "@server_form.mining_tycoon_long_form"
                }
              }
            }
          }
        ]
      }
    ]
  },
  "long_form": {
    "modifications": [
      {
        "array_name": "bindings",
        "operation": "insert_back",
        "value": [
          {
            "binding_name": "#title_text"
          },
          {
            "binding_type": "view",
            "source_property_name": "((#title_text - '§m§t§s') = #title_text)",
            "target_property_name": "#visible"
          }
        ]
      }
    ]
  },
  "mining_tycoon_long_form": {
    "type": "panel",
    "size": [
      "100%",
      "100%"
    ],
    "controls": [
      {
        "start_menu@server_form.mining_tycoon_start_menu": {
          "bindings": [
            {
              "binding_name": "#title_text"
            },
            {
              "binding_type": "view",
              "source_property_name": "(not ((#title_text - '§m§t§s') = #title_text))",
              "target_property_name": "#visible"
            }
          ]
        }
      }
    ]
  },
  "mining_tycoon_start_menu": {
    "type": "panel",
    "size": [
      "100%",
      "100%"
    ],
    "layer": 10,
    "controls": [
      {
        "background": {
          "type": "image",
          "texture": "textures/mining_tycoon/ui/menu_bg",
          "size": [
            "100% + 64px",
            "100% + 32px"
          ],
          "anchor_from": "center",
          "anchor_to": "center",
          "layer": 1
        }
      },
      {
        "content": {
          "type": "stack_panel",
          "orientation": "vertical",
          "size": [
            190,
            "100%c"
          ],
          "anchor_from": "center",
          "anchor_to": "center",
          "layer": 2,
          "controls": [
            {
              "logo": {
                "type": "label",
                "text": "MINING TYCOON",
                "font_type": "MinecraftTen",
                "font_scale_factor": 2.0,
                "color": [
                  1.0,
                  0.82,
                  0.28
                ],
                "shadow": true,
                "text_alignment": "center",
                "size": [
                  "100%",
                  "default"
                ]
              }
            },
            {
              "logo_gap": {
                "type": "panel",
                "size": [
                  "100%",
                  6
                ]
              }
            },
            {
              "body": {
                "type": "label",
                "text": "#form_text",
                "color": [
                  0.92,
                  0.92,
                  0.92
                ],
                "shadow": true,
                "text_alignment": "center",
                "size": [
                  "100%",
                  "default"
                ],
                "bindings": [
                  {
                    "binding_name": "#form_text"
                  }
                ]
              }
            },
            {
              "body_gap": {
                "type": "panel",
                "size": [
                  "100%",
                  10
                ]
              }
            },
            {
              "buttons@server_form.mining_tycoon_menu_buttons": {}
            }
          ]
        }
      }
    ]
  },
  "mining_tycoon_menu_buttons": {
    "type": "stack_panel",
    "orientation": "vertical",
    "size": [
      "100%",
      "100%c"
    ],
    "factory": {
      "name": "buttons",
      "control_ids": {
        "button": "@server_form.mining_tycoon_menu_button"
      }
    },
    "collection_name": "form_buttons",
    "bindings": [
      {
        "binding_name": "#form_button_contents",
        "binding_name_override": "#collection_length"
      }
    ]
  },
  "mining_tycoon_menu_button": {
    "type": "panel",
    "size": [
      "100%",
      34
    ],
    "controls": [
      {
        "form_button@common.button": {
          "$pressed_button_name": "button.form_button_click",
          "size": [
            "100%",
            30
          ],
          "anchor_from": "top_middle",
          "anchor_to": "top_middle",
          "bindings": [
            {
              "binding_type": "collection_details",
              "binding_collection_name": "form_buttons"
            }
          ],
          "controls": [
            {
              "default@server_form.mining_tycoon_button_state": {
                "$state_texture": "textures/mining_tycoon/ui/button",
                "$state_text_color": [
                  1.0,
                  0.84,
                  0.35
                ]
              }
            },
            {
              "hover@server_form.mining_tycoon_button_state": {
                "$state_texture": "textures/mining_tycoon/ui/button_hover",
                "$state_text_color": [
                  1.0,
                  0.96,
                  0.75
                ]
              }
            },
            {
              "pressed@server_form.mining_tycoon_button_state": {
                "$state_texture": "textures/mining_tycoon/ui/button_pressed",
                "$state_text_color": [
                  1.0,
                  0.96,
                  0.75
                ],
                "$state_text_offset": [
                  0,
                  1
                ]
              }
            }
          ]
        }
      }
    ]
  },
  "mining_tycoon_button_state": {
    "type": "image",
    "texture": "$state_texture",
    "size": [
      "100%",
      "100%"
    ],
    "$state_text_offset|default": [
      0,
      0
    ],
    "controls": [
      {
        "label": {
          "type": "label",
          "text": "#form_button_text",
          "color": "$state_text_color",
          "shadow": true,
          "text_alignment": "center",
          "offset": "$state_text_offset",
          "size": [
            "100% - 12px",
            "default"
          ],
          "max_size": [
            "100% - 12px",
            22
          ],
          "layer": 1,
          "bindings": [
            {
              "binding_name": "#form_button_text",
              "binding_type": "collection",
              "binding_collection_name": "form_buttons"
            }
          ]
        }
      }
    ]
  }
}
