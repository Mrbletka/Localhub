{
  "namespace": "server_form",
  "main_screen_content": {
    "size": [
      "100%",
      "100%"
    ],
    "modifications": [
      {
        "array_name": "controls",
        "operation": "insert_back",
        "value": [
          {
            "mining_tycoon_form_factory": {
              "type": "panel",
              "size": [
                "100%",
                "100%"
              ],
              "factory": {
                "name": "server_form_factory",
                "control_ids": {
                  "long_form": "@server_form.mining_tycoon_long_form"
                }
              }
            }
          }
        ]
      }
    ]
  },
  "long_form": {
    "modifications": [
      {
        "array_name": "bindings",
        "operation": "insert_back",
        "value": [
          {
            "binding_name": "#title_text"
          },
          {
            "binding_type": "view",
            "source_property_name": "((#title_text - '§m§t§s') = #title_text)",
            "target_property_name": "#visible"
          }
        ]
      }
    ]
  },
  "mining_tycoon_long_form": {
    "type": "panel",
    "size": [
      "100%",
      "100%"
    ],
    "controls": [
      {
        "start_menu@server_form.mining_tycoon_start_menu": {
          "bindings": [
            {
              "binding_name": "#title_text"
            },
            {
              "binding_type": "view",
              "source_property_name": "(not ((#title_text - '§m§t§s') = #title_text))",
              "target_property_name": "#visible"
            }
          ]
        }
      }
    ]
  },
  "mining_tycoon_start_menu": {
    "type": "panel",
    "size": [
      "100%",
      "100%"
    ],
    "layer": 10,
    "controls": [
      {
        "background": {
          "type": "image",
          "texture": "textures/mining_tycoon/ui/menu_bg",
          "size": [
            "100% + 64px",
            "100% + 32px"
          ],
          "anchor_from": "center",
          "anchor_to": "center",
          "layer": 1
        }
      },
      {
        "content": {
          "type": "stack_panel",
          "orientation": "vertical",
          "size": [
            190,
            "100%c"
          ],
          "anchor_from": "center",
          "anchor_to": "center",
          "layer": 2,
          "controls": [
            {
              "logo": {
                "type": "label",
                "text": "MINING TYCOON",
                "color": [
                  1.0,
                  0.82,
                  0.28
                ],
                "shadow": true,
                "text_alignment": "center",
                "size": [
                  "100%",
                  "default"
                ],
                "font_type": "MinecraftTen",
                "font_scale_factor": 2.0
              }
            },
            {
              "logo_gap": {
                "type": "panel",
                "size": [
                  "100%",
                  6
                ]
              }
            },
            {
              "page_start": {
                "type": "stack_panel",
                "orientation": "vertical",
                "size": [
                  "100%",
                  "100%c"
                ],
                "bindings": [
                  {
                    "binding_type": "view",
                    "source_control_name": "mining_tycoon_go_sessions",
                    "source_property_name": "(not #toggle_state)",
                    "target_property_name": "#visible"
                  }
                ],
                "controls": [
                  {
                    "body": {
                      "type": "label",
                      "text": "#form_text",
                      "color": [
                        0.92,
                        0.92,
                        0.92
                      ],
                      "shadow": true,
                      "text_alignment": "center",
                      "size": [
                        "100%",
                        "default"
                      ],
                      "bindings": [
                        {
                          "binding_name": "#form_text"
                        }
                      ]
                    }
                  },
                  {
                    "body_gap": {
                      "type": "panel",
                      "size": [
                        "100%",
                        10
                      ]
                    }
                  },
                  {
                    "list_1@server_form.mining_tycoon_list_1": {}
                  },
                  {
                    "sessions_row": {
                      "type": "panel",
                      "size": [
                        "100%",
                        34
                      ],
                      "bindings": [
                        {
                          "binding_name": "#title_text"
                        },
                        {
                          "binding_type": "view",
                          "source_property_name": "(not ((#title_text - '§h§s') = #title_text))",
                          "target_property_name": "#visible"
                        }
                      ],
                      "controls": [
                        {
                          "mining_tycoon_go_sessions@server_form.mining_tycoon_nav_toggle": {
                            "$nav_text": "Sessions",
                            "$toggle_group_forced_index": 1
                          }
                        }
                      ]
                    }
                  },
                  {
                    "list_2@server_form.mining_tycoon_list_2": {}
                  }
                ]
              }
            },
            {
              "page_sessions": {
                "type": "stack_panel",
                "orientation": "vertical",
                "size": [
                  "100%",
                  "100%c"
                ],
                "bindings": [
                  {
                    "binding_type": "view",
                    "source_control_name": "mining_tycoon_go_sessions",
                    "source_property_name": "#toggle_state",
                    "target_property_name": "#visible"
                  }
                ],
                "controls": [
                  {
                    "heading": {
                      "type": "label",
                      "text": "Your sessions: each one is its own mine and its own save.",
                      "color": [
                        0.92,
                        0.92,
                        0.92
                      ],
                      "shadow": true,
                      "text_alignment": "center",
                      "size": [
                        "100%",
                        "default"
                      ]
                    }
                  },
                  {
                    "heading_gap": {
                      "type": "panel",
                      "size": [
                        "100%",
                        10
                      ]
                    }
                  },
                  {
                    "list_3@server_form.mining_tycoon_list_3": {}
                  },
                  {
                    "back_row": {
                      "type": "panel",
                      "size": [
                        "100%",
                        34
                      ],
                      "controls": [
                        {
                          "mining_tycoon_go_start@server_form.mining_tycoon_nav_toggle": {
                            "$nav_text": "Back",
                            "$toggle_group_forced_index": 0
                          }
                        }
                      ]
                    }
                  }
                ]
              }
            }
          ]
        }
      }
    ]
  },
  "mining_tycoon_list_1": {
    "type": "stack_panel",
    "orientation": "vertical",
    "size": [
      "100%",
      "100%c"
    ],
    "factory": {
      "name": "buttons",
      "control_ids": {
        "button": "@server_form.mining_tycoon_item_1"
      }
    },
    "collection_name": "form_buttons",
    "bindings": [
      {
        "binding_name": "#form_button_contents",
        "binding_name_override": "#collection_length"
      }
