  "mining_tycoon_form_button@common.button": {
    "$pressed_button_name": "button.form_button_click",
    "size": [
      "100%",
      30
    ],
    "anchor_from": "top_middle",
    "anchor_to": "top_middle",
    "bindings": [
      {
        "binding_type": "collection_details",
        "binding_collection_name": "form_buttons"
      }
    ],
    "controls": [
      {
        "default@server_form.mining_tycoon_button_state": {
          "$state_texture": "textures/mining_tycoon/ui/button",
          "$state_text_color": [
            1.0,
            0.84,
            0.35
          ]
        }
      },
      {
        "hover@server_form.mining_tycoon_button_state": {
          "$state_texture": "textures/mining_tycoon/ui/button_hover",
          "$state_text_color": [
            1.0,
            0.96,
            0.75
          ]
        }
      },
      {
        "pressed@server_form.mining_tycoon_button_state": {
          "$state_texture": "textures/mining_tycoon/ui/button_pressed",
          "$state_text_color": [
            1.0,
            0.96,
            0.75
          ],
          "$state_text_offset": [
            0,
            1
          ]
        }
      }
    ]
  },
  "mining_tycoon_button_state": {
    "type": "image",
    "texture": "$state_texture",
    "size": [
      "100%",
      "100%"
    ],
    "$state_text_offset|default": [
      0,
      0
    ],
    "controls": [
      {
        "label": {
          "type": "label",
          "text": "#text",
          "color": "$state_text_color",
          "shadow": true,
          "text_alignment": "center",
          "size": [
            "100% - 12px",
            "default"
          ],
          "offset": "$state_text_offset",
          "max_size": [
            "100% - 12px",
            22
          ],
          "layer": 1,
          "bindings": [
            {
              "binding_name": "#form_button_text",
              "binding_type": "collection",
              "binding_collection_name": "form_buttons"
            },
            {
              "binding_type": "view",
              "source_property_name": "(#form_button_text - '§p§1§r' - '§p§2§r' - '§p§3§r')",
              "target_property_name": "#text"
            }
          ]
        }
      }
    ]
  },
  "mining_tycoon_nav_toggle@common.toggle": {
    "size": [
      "100%",
      30
    ],
    "anchor_from": "top_middle",
    "anchor_to": "top_middle",
    "$toggle_name": "mining_tycoon_page",
    "$radio_toggle_group": true,
    "$toggle_group_default_selected": 0,
    "$toggle_binding_type": "none",
    "$unchecked_control": "server_form.mining_tycoon_nav_default",
    "$checked_control": "server_form.mining_tycoon_nav_default",
    "$unchecked_hover_control": "server_form.mining_tycoon_nav_hover",
    "$checked_hover_control": "server_form.mining_tycoon_nav_hover",
    "$unchecked_locked_control": "server_form.mining_tycoon_nav_default",
    "$unchecked_locked_hover_control": "server_form.mining_tycoon_nav_default",
    "$checked_locked_control": "server_form.mining_tycoon_nav_default",
    "$checked_locked_hover_control": "server_form.mining_tycoon_nav_default"
  },
  "mining_tycoon_nav_default": {
    "type": "image",
    "texture": "textures/mining_tycoon/ui/button",
    "size": [
      "100%",
      "100%"
    ],
    "controls": [
      {
        "label": {
          "type": "label",
          "text": "$nav_text",
          "color": [
            1.0,
            0.84,
            0.35
          ],
          "shadow": true,
          "text_alignment": "center",
          "size": [
            "100% - 12px",
            "default"
          ],
          "layer": 1
        }
      }
    ]
  },
  "mining_tycoon_nav_hover": {
